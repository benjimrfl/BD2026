{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Nombre de instancia de Data Factory",
			"defaultValue": "ADF-BD2026"
		},
		"database_password": {
			"type": "secureString",
			"metadata": "Cadena protegida para \"password\"de \"database\""
		},
		"OPENSKY API_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://opensky-network.org/api/states/all"
		},
		"database_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "aerodata2026.database.windows.net"
		},
		"database_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "aerodata2026"
		},
		"database_properties_typeProperties_userName": {
			"type": "string",
			"defaultValue": "aerodata2026"
		},
		"datalake_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://2026bigdata.dfs.core.windows.net/"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "[concat(parameters('factoryName'), '/OPENSKY API')]",
			"type": "Microsoft.DataFactory/factories/linkedServices",
			"apiVersion": "2018-06-01",
			"properties": {
				"annotations": [],
				"type": "HttpServer",
				"typeProperties": {
					"url": "[parameters('OPENSKY API_properties_typeProperties_url')]",
					"enableServerCertificateValidation": true,
					"authenticationType": "Anonymous"
				}
			},
			"dependsOn": []
		},
		{
			"name": "[concat(parameters('factoryName'), '/database')]",
			"type": "Microsoft.DataFactory/factories/linkedServices",
			"apiVersion": "2018-06-01",
			"properties": {
				"annotations": [],
				"type": "AzureSqlDatabase",
				"typeProperties": {
					"server": "[parameters('database_properties_typeProperties_server')]",
					"database": "[parameters('database_properties_typeProperties_database')]",
					"encrypt": "mandatory",
					"trustServerCertificate": false,
					"authenticationType": "SQL",
					"userName": "[parameters('database_properties_typeProperties_userName')]",
					"password": {
						"type": "SecureString",
						"value": "[parameters('database_password')]"
					}
				}
			},
			"dependsOn": []
		},
		{
			"name": "[concat(parameters('factoryName'), '/datalake')]",
			"type": "Microsoft.DataFactory/factories/linkedServices",
			"apiVersion": "2018-06-01",
			"properties": {
				"annotations": [],
				"type": "AzureBlobFS",
				"typeProperties": {
					"url": "[parameters('datalake_properties_typeProperties_url')]"
				}
			},
			"dependsOn": []
		},
		{
			"name": "[concat(parameters('factoryName'), '/OPENSKY_API')]",
			"type": "Microsoft.DataFactory/factories/datasets",
			"apiVersion": "2018-06-01",
			"properties": {
				"linkedServiceName": {
					"referenceName": "OPENSKY API",
					"type": "LinkedServiceReference"
				},
				"annotations": [],
				"type": "Json",
				"typeProperties": {
					"location": {
						"type": "HttpServerLocation"
					}
				},
				"schema": {
					"type": "object",
					"properties": {
						"time": {
							"type": "integer"
						},
						"states": {
							"type": "array",
							"items": {
								"type": "array",
								"items": {
									"type": "string"
								}
							}
						}
					}
				}
			},
			"dependsOn": [
				"[concat(variables('factoryId'), '/linkedServices/OPENSKY API')]"
			]
		},
		{
			"name": "[concat(parameters('factoryName'), '/ORO')]",
			"type": "Microsoft.DataFactory/factories/datasets",
			"apiVersion": "2018-06-01",
			"properties": {
				"linkedServiceName": {
					"referenceName": "datalake",
					"type": "LinkedServiceReference"
				},
				"parameters": {
					"timestamp": {
						"type": "string"
					}
				},
				"annotations": [],
				"type": "Parquet",
				"typeProperties": {
					"location": {
						"type": "AzureBlobFSLocation",
						"fileName": {
							"value": "@dataset().timestamp",
							"type": "Expression"
						},
						"folderPath": "plata",
						"fileSystem": "aerodata"
					},
					"compressionCodec": "snappy"
				},
				"schema": []
			},
			"dependsOn": [
				"[concat(variables('factoryId'), '/linkedServices/datalake')]"
			]
		},
		{
			"name": "[concat(parameters('factoryName'), '/Plata')]",
			"type": "Microsoft.DataFactory/factories/datasets",
			"apiVersion": "2018-06-01",
			"properties": {
				"linkedServiceName": {
					"referenceName": "datalake",
					"type": "LinkedServiceReference"
				},
				"annotations": [],
				"type": "Parquet",
				"typeProperties": {
					"location": {
						"type": "AzureBlobFSLocation",
						"folderPath": "plata",
						"fileSystem": "aerodata"
					},
					"compressionCodec": "snappy"
				},
				"schema": [
					{
						"name": "icao24",
						"type": "UTF8"
					},
					{
						"name": "callsign",
						"type": "UTF8"
					},
					{
						"name": "origin_country",
						"type": "UTF8"
					},
					{
						"name": "time_position",
						"type": "UTF8"
					},
					{
						"name": "last_contact",
						"type": "UTF8"
					},
					{
						"name": "longitude",
						"type": "UTF8"
					},
					{
						"name": "latitude",
						"type": "UTF8"
					},
					{
						"name": "baro_altitude",
						"type": "UTF8"
					},
					{
						"name": "on_ground",
						"type": "UTF8"
					},
					{
						"name": "velocity",
						"type": "UTF8"
					},
					{
						"name": "true_track",
						"type": "UTF8"
					},
					{
						"name": "vertical_rate",
						"type": "UTF8"
					},
					{
						"name": "sensors",
						"type": "UTF8"
					},
					{
						"name": "geo_altitude",
						"type": "UTF8"
					},
					{
						"name": "squawk",
						"type": "UTF8"
					},
					{
						"name": "spi",
						"type": "UTF8"
					},
					{
						"name": "position_source",
						"type": "UTF8"
					},
					{
						"name": "category",
						"type": "UTF8"
					}
				]
			},
			"dependsOn": [
				"[concat(variables('factoryId'), '/linkedServices/datalake')]"
			]
		},
		{
			"name": "[concat(parameters('factoryName'), '/bronce')]",
			"type": "Microsoft.DataFactory/factories/datasets",
			"apiVersion": "2018-06-01",
			"properties": {
				"linkedServiceName": {
					"referenceName": "datalake",
					"type": "LinkedServiceReference"
				},
				"parameters": {
					"timestamp": {
						"type": "string"
					}
				},
				"annotations": [],
				"type": "Json",
				"typeProperties": {
					"location": {
						"type": "AzureBlobFSLocation",
						"fileName": {
							"value": "@dataset().timestamp",
							"type": "Expression"
						},
						"folderPath": "bronce",
						"fileSystem": "aerodata"
					}
				},
				"schema": {
					"type": "object",
					"properties": {
						"time": {
							"type": "integer"
						},
						"states": {
							"type": "array",
							"items": {
								"type": "array",
								"items": {
									"type": "string"
								}
							}
						}
					}
				}
			},
			"dependsOn": [
				"[concat(variables('factoryId'), '/linkedServices/datalake')]"
			]
		},
		{
			"name": "[concat(parameters('factoryName'), '/FT')]",
			"type": "Microsoft.DataFactory/factories/dataflows",
			"apiVersion": "2018-06-01",
			"properties": {
				"type": "MappingDataFlow",
				"typeProperties": {
					"sources": [
						{
							"linkedService": {
								"referenceName": "database",
								"type": "LinkedServiceReference"
							},
							"name": "ORO"
						},
						{
							"linkedService": {
								"referenceName": "database",
								"type": "LinkedServiceReference"
							},
							"name": "pais"
						},
						{
							"linkedService": {
								"referenceName": "database",
								"type": "LinkedServiceReference"
							},
							"name": "aviones"
						}
					],
					"sinks": [
						{
							"linkedService": {
								"referenceName": "database",
								"type": "LinkedServiceReference"
							},
							"name": "sink1"
						}
					],
					"transformations": [
						{
							"name": "join1"
						},
						{
							"name": "select1"
						},
						{
							"name": "join2"
						},
						{
							"name": "select2"
						}
					],
					"scriptLines": [
						"source(output(",
						"          id_vuelo as integer,",
						"          icao24 as string,",
						"          callsign as string,",
						"          origin_country as string,",
						"          time_position as timestamp,",
						"          last_contact as timestamp,",
						"          longitude as double,",
						"          latitude as double,",
						"          baro_altitude as double,",
						"          on_ground as boolean,",
						"          velocity as double,",
						"          true_track as double,",
						"          vertical_rate as double,",
						"          geo_altitude as double,",
						"          squawk as string,",
						"          spi as boolean,",
						"          position_source as integer,",
						"          category as integer,",
						"          fecha_insercion as timestamp",
						"     ),",
						"     allowSchemaDrift: true,",
						"     validateSchema: false,",
						"     format: 'table',",
						"     store: 'sqlserver',",
						"     schemaName: 'dbo',",
						"     tableName: 'oro',",
						"     isolationLevel: 'READ_UNCOMMITTED') ~> ORO",
						"source(output(",
						"          id_pais as integer,",
						"          descripcion as string,",
						"          creacion as timestamp",
						"     ),",
						"     allowSchemaDrift: true,",
						"     validateSchema: false,",
						"     format: 'table',",
						"     store: 'sqlserver',",
						"     schemaName: 'dbo',",
						"     tableName: 'd_pais',",
						"     isolationLevel: 'READ_UNCOMMITTED') ~> pais",
						"source(output(",
						"          id_avion as integer,",
						"          descripcion as string,",
						"          creacion as timestamp",
						"     ),",
						"     allowSchemaDrift: true,",
						"     validateSchema: false,",
						"     format: 'table',",
						"     store: 'sqlserver',",
						"     schemaName: 'dbo',",
						"     tableName: 'd_aviones',",
						"     isolationLevel: 'READ_UNCOMMITTED') ~> aviones",
						"select1, pais join(origin_country == descripcion,",
						"     joinType:'inner',",
						"     matchType:'exact',",
						"     ignoreSpaces: false,",
						"     broadcast: 'auto')~> join1",
						"ORO select(mapColumn(",
						"          callsign,",
						"          origin_country,",
						"          time_position,",
						"          last_contact,",
						"          longitude,",
						"          latitude,",
						"          baro_altitude,",
						"          on_ground,",
						"          velocity,",
						"          true_track,",
						"          vertical_rate,",
						"          geo_altitude,",
						"          position_source,",
						"          category",
						"     ),",
						"     skipDuplicateMapInputs: true,",
						"     skipDuplicateMapOutputs: true) ~> select1",
						"join1, aviones join(callsign == aviones@descripcion,",
						"     joinType:'inner',",
						"     matchType:'exact',",
						"     ignoreSpaces: false,",
						"     broadcast: 'auto')~> join2",
						"join2 select(mapColumn(",
						"          id_avion,",
						"          id_pais,",
						"          ultima_posicion = time_position,",
						"          ultimo_contacto = last_contact,",
						"          longitud = longitude,",
						"          latitud = latitude,",
						"          altitud_bar = baro_altitude,",
						"          altitud_geo = geo_altitude,",
						"          en_suelo = on_ground,",
						"          velocidad = velocity,",
						"          rumbo_grados = true_track,",
						"          tasa_vertical = vertical_rate,",
						"          id_posicion = position_source,",
						"          id_categoria = category",
						"     ),",
						"     skipDuplicateMapInputs: true,",
						"     skipDuplicateMapOutputs: true) ~> select2",
						"select2 sink(allowSchemaDrift: true,",
						"     validateSchema: false,",
						"     format: 'table',",
						"     store: 'sqlserver',",
						"     schemaName: 'dbo',",
						"     tableName: 'ft_vuelos',",
						"     insertable: true,",
						"     updateable: false,",
						"     deletable: false,",
						"     upsertable: false,",
						"     skipDuplicateMapInputs: true,",
						"     skipDuplicateMapOutputs: true,",
						"     errorHandlingOption: 'stopOnFirstError') ~> sink1"
					]
				}
			},
			"dependsOn": [
				"[concat(variables('factoryId'), '/linkedServices/database')]"
			]
		},
		{
			"name": "[concat(parameters('factoryName'), '/BRONCE')]",
			"type": "Microsoft.DataFactory/factories/pipelines",
			"apiVersion": "2018-06-01",
			"properties": {
				"activities": [
					{
						"name": "GET_DATA",
						"type": "Copy",
						"dependsOn": [],
						"policy": {
							"timeout": "0.12:00:00",
							"retry": 0,
							"retryIntervalInSeconds": 30,
							"secureOutput": false,
							"secureInput": false
						},
						"userProperties": [],
						"typeProperties": {
							"source": {
								"type": "JsonSource",
								"storeSettings": {
									"type": "HttpReadSettings",
									"requestMethod": "GET"
								},
								"formatSettings": {
									"type": "JsonReadSettings"
								}
							},
							"sink": {
								"type": "JsonSink",
								"storeSettings": {
									"type": "AzureBlobFSWriteSettings"
								},
								"formatSettings": {
									"type": "JsonWriteSettings"
								}
							},
							"enableStaging": false
						},
						"inputs": [
							{
								"referenceName": "OPENSKY_API",
								"type": "DatasetReference",
								"parameters": {}
							}
						],
						"outputs": [
							{
								"referenceName": "bronce",
								"type": "DatasetReference",
								"parameters": {
									"timestamp": {
										"value": "@pipeline().parameters.timestamp",
										"type": "Expression"
									}
								}
							}
						]
					}
				],
				"policy": {
					"elapsedTimeMetric": {}
				},
				"parameters": {
					"timestamp": {
						"type": "string"
					}
				},
				"annotations": []
			},
			"dependsOn": [
				"[concat(variables('factoryId'), '/datasets/OPENSKY_API')]",
				"[concat(variables('factoryId'), '/datasets/bronce')]"
			]
		},
		{
			"name": "[concat(parameters('factoryName'), '/ORO')]",
			"type": "Microsoft.DataFactory/factories/dataflows",
			"apiVersion": "2018-06-01",
			"properties": {
				"type": "MappingDataFlow",
				"typeProperties": {
					"sources": [
						{
							"dataset": {
								"referenceName": "ORO",
								"type": "DatasetReference"
							},
							"name": "PLATA"
						},
						{
							"linkedService": {
								"referenceName": "database",
								"type": "LinkedServiceReference"
							},
							"name": "paises"
						},
						{
							"linkedService": {
								"referenceName": "database",
								"type": "LinkedServiceReference"
							},
							"name": "aviones"
						}
					],
					"sinks": [
						{
							"linkedService": {
								"referenceName": "database",
								"type": "LinkedServiceReference"
							},
							"name": "sink1"
						},
						{
							"linkedService": {
								"referenceName": "database",
								"type": "LinkedServiceReference"
							},
							"name": "sink2"
						},
						{
							"linkedService": {
								"referenceName": "database",
								"type": "LinkedServiceReference"
							},
							"name": "sink3"
						}
					],
					"transformations": [
						{
							"name": "derivedColumn1"
						},
						{
							"name": "select1"
						},
						{
							"name": "aggregate1"
						},
						{
							"name": "select2"
						},
						{
							"name": "join1"
						},
						{
							"name": "select3"
						},
						{
							"name": "alterRow1"
						},
						{
							"name": "select4"
						},
						{
							"name": "aggregate2"
						},
						{
							"name": "select5"
						},
						{
							"name": "filter1"
						},
						{
							"name": "join2"
						},
						{
							"name": "alterRow2"
						}
					],
					"scriptLines": [
						"parameters{",
						"     timestamp as string",
						"}",
						"source(output(",
						"          icao24 as string,",
						"          callsign as string,",
						"          origin_country as string,",
						"          time_position as string,",
						"          last_contact as string,",
						"          longitude as string,",
						"          latitude as string,",
						"          baro_altitude as string,",
						"          on_ground as string,",
						"          velocity as string,",
						"          true_track as string,",
						"          vertical_rate as string,",
						"          sensors as string,",
						"          geo_altitude as string,",
						"          squawk as string,",
						"          spi as string,",
						"          position_source as string,",
						"          category as string",
						"     ),",
						"     allowSchemaDrift: true,",
						"     validateSchema: false,",
						"     ignoreNoFilesFound: false,",
						"     format: 'parquet') ~> PLATA",
						"source(output(",
						"          id_pais as integer,",
						"          descripcion as string,",
						"          creacion as timestamp",
						"     ),",
						"     allowSchemaDrift: true,",
						"     validateSchema: false,",
						"     format: 'table',",
						"     store: 'sqlserver',",
						"     schemaName: 'dbo',",
						"     tableName: 'd_pais',",
						"     isolationLevel: 'READ_UNCOMMITTED') ~> paises",
						"source(output(",
						"          id_avion as integer,",
						"          descripcion as string,",
						"          creacion as timestamp",
						"     ),",
						"     allowSchemaDrift: true,",
						"     validateSchema: false,",
						"     format: 'table',",
						"     store: 'sqlserver',",
						"     schemaName: 'dbo',",
						"     tableName: 'd_aviones',",
						"     isolationLevel: 'READ_UNCOMMITTED') ~> aviones",
						"PLATA derive(time_position = toTimestamp(toLong(time_position) * 1000),",
						"          last_contact = toTimestamp(toLong(last_contact) * 1000),",
						"          longitude = toFloat(longitude),",
						"          latitude = toFloat(latitude),",
						"          baro_altitude = toFloat(baro_altitude),",
						"          on_ground = toBoolean(on_ground),",
						"          velocity = toFloat(velocity),",
						"          true_track = toFloat(true_track),",
						"          vertical_rate = toFloat(vertical_rate),",
						"          geo_altitude = toFloat(geo_altitude),",
						"          spi = toBoolean(spi),",
						"          position_source = toInteger(position_source),",
						"          category = iif(isNull(category), 0, toInteger(category))) ~> derivedColumn1",
						"derivedColumn1 select(mapColumn(",
						"          origin_country,",
						"          icao24",
						"     ),",
						"     skipDuplicateMapInputs: true,",
						"     skipDuplicateMapOutputs: true) ~> select1",
						"select1 aggregate(groupBy(origin_country),",
						"     icao24 = first(icao24)) ~> aggregate1",
						"paises select(mapColumn(",
						"          id_pais,",
						"          descripcion",
						"     ),",
						"     skipDuplicateMapInputs: true,",
						"     skipDuplicateMapOutputs: true) ~> select2",
						"aggregate1, select2 join(origin_country == descripcion,",
						"     joinType:'left',",
						"     matchType:'exact',",
						"     ignoreSpaces: false,",
						"     broadcast: 'auto')~> join1",
						"join1 select(mapColumn(",
						"          origin_country,",
						"          descripcion",
						"     ),",
						"     skipDuplicateMapInputs: true,",
						"     skipDuplicateMapOutputs: true) ~> select3",
						"select3 alterRow(insertIf(origin_country!=descripcion)) ~> alterRow1",
						"derivedColumn1 select(mapColumn(",
						"          icao24,",
						"          callsign",
						"     ),",
						"     skipDuplicateMapInputs: true,",
						"     skipDuplicateMapOutputs: true) ~> select4",
						"select4 aggregate(groupBy(callsign),",
						"     icao24 = first(icao24)) ~> aggregate2",
						"aviones select(mapColumn(",
						"          id_avion,",
						"          descripcion",
						"     ),",
						"     skipDuplicateMapInputs: true,",
						"     skipDuplicateMapOutputs: true) ~> select5",
						"aggregate2 filter(callsign != '') ~> filter1",
						"filter1, select5 join(callsign == descripcion,",
						"     joinType:'left',",
						"     matchType:'exact',",
						"     ignoreSpaces: false,",
						"     broadcast: 'auto')~> join2",
						"join2 alterRow(insertIf(callsign!=descripcion)) ~> alterRow2",
						"derivedColumn1 sink(allowSchemaDrift: true,",
						"     validateSchema: false,",
						"     format: 'table',",
