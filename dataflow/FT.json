{
	"name": "FT",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"linkedService": {
						"referenceName": "database",
						"type": "LinkedServiceReference"
					},
					"name": "ORO"
				},
				{
					"linkedService": {
						"referenceName": "database",
						"type": "LinkedServiceReference"
					},
					"name": "pais"
				},
				{
					"linkedService": {
						"referenceName": "database",
						"type": "LinkedServiceReference"
					},
					"name": "aviones"
				}
			],
			"sinks": [
				{
					"linkedService": {
						"referenceName": "database",
						"type": "LinkedServiceReference"
					},
					"name": "sink1"
				}
			],
			"transformations": [
				{
					"name": "join1"
				},
				{
					"name": "select1"
				},
				{
					"name": "join2"
				},
				{
					"name": "select2"
				}
			],
			"scriptLines": [
				"source(output(",
				"          id_vuelo as integer,",
				"          icao24 as string,",
				"          callsign as string,",
				"          origin_country as string,",
				"          time_position as timestamp,",
				"          last_contact as timestamp,",
				"          longitude as double,",
				"          latitude as double,",
				"          baro_altitude as double,",
				"          on_ground as boolean,",
				"          velocity as double,",
				"          true_track as double,",
				"          vertical_rate as double,",
				"          geo_altitude as double,",
				"          squawk as string,",
				"          spi as boolean,",
				"          position_source as integer,",
				"          category as integer,",
				"          fecha_insercion as timestamp",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     format: 'table',",
				"     store: 'sqlserver',",
				"     schemaName: 'dbo',",
				"     tableName: 'oro',",
				"     isolationLevel: 'READ_UNCOMMITTED') ~> ORO",
				"source(output(",
				"          id_pais as integer,",
				"          descripcion as string,",
				"          creacion as timestamp",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     format: 'table',",
				"     store: 'sqlserver',",
				"     schemaName: 'dbo',",
				"     tableName: 'd_pais',",
				"     isolationLevel: 'READ_UNCOMMITTED') ~> pais",
				"source(output(",
				"          id_avion as integer,",
				"          descripcion as string,",
				"          creacion as timestamp",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     format: 'table',",
				"     store: 'sqlserver',",
				"     schemaName: 'dbo',",
				"     tableName: 'd_aviones',",
				"     isolationLevel: 'READ_UNCOMMITTED') ~> aviones",
				"select1, pais join(origin_country == descripcion,",
				"     joinType:'inner',",
				"     matchType:'exact',",
				"     ignoreSpaces: false,",
				"     broadcast: 'auto')~> join1",
				"ORO select(mapColumn(",
				"          callsign,",
				"          origin_country,",
				"          time_position,",
				"          last_contact,",
				"          longitude,",
				"          latitude,",
				"          baro_altitude,",
				"          on_ground,",
				"          velocity,",
				"          true_track,",
				"          vertical_rate,",
				"          geo_altitude,",
				"          position_source,",
				"          category",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> select1",
				"join1, aviones join(callsign == aviones@descripcion,",
				"     joinType:'inner',",
				"     matchType:'exact',",
				"     ignoreSpaces: false,",
				"     broadcast: 'auto')~> join2",
				"join2 select(mapColumn(",
				"          id_avion,",
				"          id_pais,",
				"          ultima_posicion = time_position,",
				"          ultimo_contacto = last_contact,",
				"          longitud = longitude,",
				"          latitud = latitude,",
				"          altitud_bar = baro_altitude,",
				"          altitud_geo = geo_altitude,",
				"          en_suelo = on_ground,",
				"          velocidad = velocity,",
				"          rumbo_grados = true_track,",
				"          tasa_vertical = vertical_rate,",
				"          id_posicion = position_source,",
				"          id_categoria = category",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> select2",
				"select2 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     format: 'table',",
				"     store: 'sqlserver',",
				"     schemaName: 'dbo',",
				"     tableName: 'ft_vuelos',",
				"     insertable: true,",
				"     updateable: false,",
				"     deletable: false,",
				"     upsertable: false,",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'stopOnFirstError') ~> sink1"
			]
		}
	}
}