{
	"name": "ORO",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "ORO",
						"type": "DatasetReference"
					},
					"name": "PLATA"
				},
				{
					"linkedService": {
						"referenceName": "database",
						"type": "LinkedServiceReference"
					},
					"name": "paises"
				}
			],
			"sinks": [
				{
					"linkedService": {
						"referenceName": "database",
						"type": "LinkedServiceReference"
					},
					"name": "sink1"
				},
				{
					"linkedService": {
						"referenceName": "database",
						"type": "LinkedServiceReference"
					},
					"name": "sink2"
				}
			],
			"transformations": [
				{
					"name": "derivedColumn1"
				},
				{
					"name": "select1"
				},
				{
					"name": "aggregate1"
				},
				{
					"name": "select2"
				},
				{
					"name": "join1"
				},
				{
					"name": "select3"
				},
				{
					"name": "alterRow1"
				}
			],
			"scriptLines": [
				"parameters{",
				"     timestamp as string",
				"}",
				"source(output(",
				"          icao24 as string,",
				"          callsign as string,",
				"          origin_country as string,",
				"          time_position as string,",
				"          last_contact as string,",
				"          longitude as string,",
				"          latitude as string,",
				"          baro_altitude as string,",
				"          on_ground as string,",
				"          velocity as string,",
				"          true_track as string,",
				"          vertical_rate as string,",
				"          sensors as string,",
				"          geo_altitude as string,",
				"          squawk as string,",
				"          spi as string,",
				"          position_source as string,",
				"          category as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false,",
				"     format: 'parquet') ~> PLATA",
				"source(output(",
				"          id_pais as integer,",
				"          descripcion as string,",
				"          creacion as timestamp",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     format: 'table',",
				"     store: 'sqlserver',",
				"     schemaName: 'dbo',",
				"     tableName: 'd_pais',",
				"     isolationLevel: 'READ_UNCOMMITTED') ~> paises",
				"PLATA derive(time_position = toTimestamp(toLong(time_position) * 1000),",
				"          last_contact = toTimestamp(toLong(last_contact) * 1000),",
				"          longitude = toFloat(longitude),",
				"          latitude = toFloat(latitude),",
				"          baro_altitude = toFloat(baro_altitude),",
				"          on_ground = toBoolean(on_ground),",
				"          velocity = toFloat(velocity),",
				"          true_track = toFloat(true_track),",
				"          vertical_rate = toFloat(vertical_rate),",
				"          geo_altitude = toFloat(geo_altitude),",
				"          spi = toBoolean(spi),",
				"          position_source = toInteger(position_source),",
				"          category = iif(isNull(category), 0, toInteger(category))) ~> derivedColumn1",
				"derivedColumn1 select(mapColumn(",
				"          origin_country,",
				"          icao24",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> select1",
				"select1 aggregate(groupBy(origin_country),",
				"     icao24 = first(icao24)) ~> aggregate1",
				"paises select(mapColumn(",
				"          id_pais,",
				"          descripcion",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> select2",
				"aggregate1, select2 join(origin_country == descripcion,",
				"     joinType:'left',",
				"     matchType:'exact',",
				"     ignoreSpaces: false,",
				"     broadcast: 'auto')~> join1",
				"join1 select(mapColumn(",
				"          origin_country,",
				"          descripcion",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> select3",
				"select3 alterRow(insertIf(origin_country != descripcion)) ~> alterRow1",
				"derivedColumn1 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     format: 'table',",
				"     store: 'sqlserver',",
				"     schemaName: 'dbo',",
				"     tableName: 'ORO',",
				"     insertable: true,",
				"     updateable: false,",
				"     deletable: false,",
				"     upsertable: false,",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'stopOnFirstError') ~> sink1",
				"alterRow1 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     format: 'table',",
				"     store: 'sqlserver',",
				"     schemaName: 'dbo',",
				"     tableName: 'd_pais',",
				"     insertable: true,",
				"     updateable: false,",
				"     deletable: false,",
				"     upsertable: false,",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'stopOnFirstError',",
				"     mapColumn(",
				"          descripcion = origin_country",
				"     )) ~> sink2"
			]
		}
	}
}